# ============================================================
# 部署参数（供 docker-compose 变量插值，不注入应用）
# ============================================================
# 项目短名：用于容器名前缀，多项目共存时必须唯一
PROJECT_NAME=howe
# 宿主机绑定地址：127.0.0.1 表示仅本机可访问，交由上层网关转发
BIND_HOST=127.0.0.1
# 后端服务端口（容器内外一致）
# 应用侧的 SERVER_PORT 由 compose 从此值派生注入，改这一处即可，不要单独设 SERVER_PORT
APP_PORT=9527
# 前端服务端口（容器内外一致）
WEB_PORT=9528
# 时区
TZ=Asia/Shanghai
# Spring 激活的配置环境
SPRING_PROFILES_ACTIVE=druid

# ============================================================
# 前端构建期变量（VITE_* 在 npm run build 时被烘进静态产物）
# 注意：改这些值必须重建镜像才生效（docker compose up -d --build），
# 单独重启容器无效。接口前缀 /api 与 Nginx 反代规则硬耦合，故不做成开关。
# ============================================================
VITE_APP_TITLE=后台管理系统

# ============================================================
# 数据库（连接已有 MySQL；同一 Docker 网络内可用容器名，否则用可达地址）
# ============================================================
DB_URL=jdbc:mysql://mysql:3306/howe-system?useUnicode=true&characterEncoding=utf8&zeroDateTimeBehavior=convertToNull&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=root
DB_PASSWORD=change-me

# ============================================================
# 缓存（连接已有 Redis）
# ============================================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DATABASE=0

# ============================================================
# 令牌
# ============================================================
JWT_SECRET=please-change-me-please-change-me
JWT_EXPIRATION=30

# ============================================================
# 文件存储
# ============================================================
# 存储类型、R2 凭据（端点/密钥/桶/公开域名）以及博客的 GitHub 仓库与令牌，
# 全部在「系统管理 > 参数设置」里维护，改完即时生效，不需要重启容器，故不放在这里。
# 初始化数据见 server/sql/blog_20260730.sql。
#
# 这里只留本地文件目录：仅当存储类型为 local 时用于存放上传文件，
# 以及通用下载接口的取件目录。容器内建议 /app/uploadPath，
# 并同步在 docker-compose.yml 的 volumes 里挂出来。
PROFILE_PATH=/app/uploadPath

# ============================================================
# 接口文档（生产建议全部 false）
# ============================================================
SPRINGDOC_API_DOCS_ENABLED=true
SPRINGDOC_SWAGGER_UI_ENABLED=true

# ============================================================
# 日志
# ============================================================
# root logger 级别（logback root，兜底）
LOGGING_LEVEL_ROOT=info
# 业务包 com.howe 级别（生产建议 info）
LOGGING_LEVEL_APP=debug
# Spring 框架级别
LOGGING_LEVEL_SPRING=warn
# 容器内日志目录：由镜像固定为 /app/logs 并与 compose 的卷挂载成对，
# 如需改动必须同步 docker-compose.yml 的 volumes，否则日志不会落到宿主机

# ============================================================
# Druid 监控
# ============================================================
DRUID_LOGIN_USERNAME=howe
DRUID_LOGIN_PASSWORD=changeme
