<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.howe.share.mapper.ShareAccessLogMapper">

    <resultMap type="ShareAccessLog" id="ShareAccessLogResult">
        <result property="logId"      column="log_id"     />
        <result property="linkId"     column="link_id"    />
        <result property="code"       column="code"       />
        <result property="ip"         column="ip"         />
        <result property="userAgent"  column="user_agent" />
        <result property="action"     column="action"     />
        <result property="result"     column="result"     />
        <result property="message"    column="message"    />
        <result property="createTime" column="create_time"/>
    </resultMap>

    <sql id="selectShareAccessLogVo">
        select log_id, link_id, code, ip, user_agent, action, result, message, create_time
        from share_access_log
    </sql>

    <insert id="insertShareAccessLog" parameterType="ShareAccessLog" useGeneratedKeys="true" keyProperty="logId">
        insert into share_access_log (link_id, code, ip, user_agent, action, result, message, create_time)
        values (#{linkId}, #{code}, #{ip}, #{userAgent}, #{action}, #{result}, #{message}, sysdate())
    </insert>

    <select id="selectShareAccessLogByLinkId" parameterType="Long" resultMap="ShareAccessLogResult">
        <include refid="selectShareAccessLogVo"/>
        where link_id = #{linkId}
        order by log_id desc
    </select>

    <delete id="deleteShareAccessLogBefore">
        delete from share_access_log where create_time &lt; #{before}
    </delete>

    <delete id="deleteShareAccessLogByLinkIds" parameterType="Long">
        delete from share_access_log where link_id in
        <foreach item="linkId" collection="array" open="(" separator="," close=")">
            #{linkId}
        </foreach>
    </delete>

</mapper>
