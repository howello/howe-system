<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.howe.ai.persistence.mapper.AiModelMapper">
    <resultMap type="AiModel" id="AiModelResult">
        <result property="id"                 column="id"                  />
        <result property="channelId"          column="channel_id"          />
        <result property="capability"         column="capability"          />
        <result property="modelName"          column="model_name"          />
        <result property="displayName"        column="display_name"        />
        <result property="maxTokens"          column="max_tokens"          />
        <result property="extra"              column="extra"               />
        <result property="enabled"            column="enabled"             />
        <result property="remark"             column="remark"              />
        <result property="createBy"           column="create_by"           />
        <result property="createTime"         column="create_time"         />
        <result property="updateBy"           column="update_by"           />
        <result property="updateTime"         column="update_time"         />
        <result property="channelName"        column="channel_name"        />
        <result property="providerCode"       column="provider_code"       />
    </resultMap>

    <sql id="selectAiModelVo">
        select m.id, m.channel_id, m.capability, m.model_name, m.display_name, m.max_tokens,
               m.extra, m.enabled, m.remark, m.create_by, m.create_time, m.update_by, m.update_time,
               c.name as channel_name, c.provider_code as provider_code
        from ai_model m
        left join ai_channel c on c.id = m.channel_id
    </sql>

    <select id="selectAiModelList" parameterType="AiModel" resultMap="AiModelResult">
        <include refid="selectAiModelVo"/>
        <where>
            <if test="channelId != null">
                AND m.channel_id = #{channelId}
            </if>
            <if test="capability != null and capability != ''">
                AND m.capability = #{capability}
            </if>
            <if test="modelName != null and modelName != ''">
                AND m.model_name like concat('%', #{modelName}, '%')
            </if>
            <if test="displayName != null and displayName != ''">
                AND m.display_name like concat('%', #{displayName}, '%')
            </if>
            <if test="enabled != null">
                AND m.enabled = #{enabled}
            </if>
        </where>
        order by m.channel_id asc, m.id asc
    </select>

    <select id="selectAiModelById" parameterType="Long" resultMap="AiModelResult">
        <include refid="selectAiModelVo"/>
        where m.id = #{id}
    </select>

    <select id="selectEnabledList" resultMap="AiModelResult">
        <include refid="selectAiModelVo"/>
        where m.enabled = 1
        order by m.id asc
    </select>

    <select id="countByChannelId" parameterType="Long" resultType="int">
        select count(1) from ai_model where channel_id = #{channelId}
    </select>

    <insert id="insertAiModel" parameterType="AiModel" useGeneratedKeys="true" keyProperty="id">
        insert into ai_model (
            channel_id, capability, model_name, display_name, max_tokens, extra, enabled,
            remark, create_by, create_time
        ) values (
            #{channelId}, #{capability}, #{modelName}, #{displayName}, #{maxTokens}, #{extra}, #{enabled},
            #{remark}, #{createBy}, sysdate()
        )
    </insert>

    <update id="updateAiModel" parameterType="AiModel">
        update ai_model
        <set>
            <if test="channelId != null">channel_id = #{channelId},</if>
            <if test="capability != null and capability != ''">capability = #{capability},</if>
            <if test="modelName != null and modelName != ''">model_name = #{modelName},</if>
            <if test="displayName != null">display_name = #{displayName},</if>
            <if test="maxTokens != null">max_tokens = #{maxTokens},</if>
            <if test="extra != null">extra = #{extra},</if>
            <if test="enabled != null">enabled = #{enabled},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where id = #{id}
    </update>

    <delete id="deleteAiModelByIds" parameterType="Long">
        delete from ai_model where id in
        <foreach collection="ids" item="id" open="(" separator="," close=")">
            #{id}
        </foreach>
    </delete>
</mapper>
