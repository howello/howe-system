<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.howe.blog.mapper.BlogLinkMapper">

    <resultMap type="BlogLink" id="BlogLinkResult">
        <result property="linkId"        column="link_id"         />
        <result property="linkType"      column="link_type"       />
        <result property="linkName"      column="link_name"       />
        <result property="linkUrl"       column="link_url"        />
        <result property="avatar"        column="avatar"          />
        <result property="descr"         column="descr"           />
        <result property="groupCode"     column="group_code"      />
        <result property="rssUrl"        column="rss_url"         />
        <result property="lastSyncTime"  column="last_sync_time"  />
        <result property="lastError"     column="last_error"      />
        <result property="status"        column="status"          />
        <result property="orderNum"      column="order_num"       />
        <result property="createBy"      column="create_by"       />
        <result property="createTime"    column="create_time"     />
        <result property="updateBy"      column="update_by"       />
        <result property="updateTime"    column="update_time"     />
        <result property="remark"        column="remark"          />
    </resultMap>

    <sql id="selectBlogLinkVo">
        select link_id, link_type, link_name, link_url, avatar, descr, group_code,
               rss_url, last_sync_time, last_error, status, order_num,
               create_by, create_time, update_by, update_time, remark
        from blog_link
    </sql>

    <select id="selectBlogLinkList" parameterType="BlogLink" resultMap="BlogLinkResult">
        <include refid="selectBlogLinkVo"/>
        <where>
            <!-- link_type 由 Controller 强制固定，友链与订阅源两个入口互相看不到对方的数据 -->
            <if test="linkType != null and linkType != ''">
                AND link_type = #{linkType}
            </if>
            <if test="linkName != null and linkName != ''">
                AND link_name like concat('%', #{linkName}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
            <if test="groupCode != null and groupCode != ''">
                AND group_code = #{groupCode}
            </if>
        </where>
        order by order_num asc, link_id asc
    </select>

    <select id="selectBlogLinkById" resultMap="BlogLinkResult">
        <include refid="selectBlogLinkVo"/>
        where link_id = #{linkId} and link_type = #{linkType}
    </select>

    <!-- 供同步任务使用：只取启用且填了订阅地址的 RSS 源 -->
    <select id="selectEnabledFeeds" resultMap="BlogLinkResult">
        <include refid="selectBlogLinkVo"/>
        where link_type = '2' and status = '0' and rss_url is not null and rss_url != ''
        order by order_num asc, link_id asc
    </select>

    <insert id="insertBlogLink" parameterType="BlogLink" useGeneratedKeys="true" keyProperty="linkId">
        insert into blog_link (
            link_type,
            link_name,
            <if test="linkUrl != null">link_url,</if>
            <if test="avatar != null">avatar,</if>
            <if test="descr != null">descr,</if>
            <if test="groupCode != null">group_code,</if>
            <if test="rssUrl != null">rss_url,</if>
            <if test="status != null and status != ''">status,</if>
            <if test="orderNum != null">order_num,</if>
            <if test="remark != null">remark,</if>
            <if test="createBy != null and createBy != ''">create_by,</if>
            create_time
        )values(
            #{linkType},
            #{linkName},
            <if test="linkUrl != null">#{linkUrl},</if>
            <if test="avatar != null">#{avatar},</if>
            <if test="descr != null">#{descr},</if>
            <if test="groupCode != null">#{groupCode},</if>
            <if test="rssUrl != null">#{rssUrl},</if>
            <if test="status != null and status != ''">#{status},</if>
            <if test="orderNum != null">#{orderNum},</if>
            <if test="remark != null">#{remark},</if>
            <if test="createBy != null and createBy != ''">#{createBy},</if>
            sysdate()
        )
    </insert>

    <!--
      越权防护（关键）：where 必须同时约束 link_id 与 link_type。
      只按主键更新的话，持有 blog:feed:edit 的角色传一个友链 ID 就能改友链。
      link_type 本身不在 set 里，杜绝通过改类型绕过隔离。
    -->
    <update id="updateBlogLink" parameterType="BlogLink">
        update blog_link
        <set>
            <if test="linkName != null and linkName != ''">link_name = #{linkName},</if>
            <if test="linkUrl != null">link_url = #{linkUrl},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="descr != null">descr = #{descr},</if>
            <if test="groupCode != null">group_code = #{groupCode},</if>
            <if test="rssUrl != null">rss_url = #{rssUrl},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="orderNum != null">order_num = #{orderNum},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null and updateBy != ''">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where link_id = #{linkId} and link_type = #{linkType}
    </update>

    <!-- 同上：批量删除也必须带 link_type，Service 层再用影响行数比对拦截不匹配项 -->
    <delete id="deleteBlogLinkByIds">
        delete from blog_link where link_type = #{linkType} and link_id in
        <foreach item="linkId" collection="linkIds" open="(" separator="," close=")">
            #{linkId}
        </foreach>
    </delete>

    <!-- 同步结果回写：成功时 lastError 传空串以清空上一轮的错误信息 -->
    <update id="updateSyncResult">
        update blog_link
        set last_sync_time = #{lastSyncTime},
            last_error = #{lastError}
        where link_id = #{linkId} and link_type = '2'
    </update>

    <!-- waline 同步去重：按站点地址与类型查询，已存在则跳过写入 -->
    <select id="selectBlogLinkByUrl" resultMap="BlogLinkResult">
        <include refid="selectBlogLinkVo"/>
        where link_url = #{linkUrl} and link_type = #{linkType}
        limit 1
    </select>

</mapper>
