<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.howe.meal.mapper.MealCategoryMapper">

    <resultMap type="MealCategory" id="MealCategoryResult">
        <result property="categoryId"  column="category_id"  />
        <result property="deptId"      column="dept_id"      />
        <result property="name"        column="name"         />
        <result property="icon"        column="icon"         />
        <result property="sort"        column="sort"         />
        <result property="status"      column="status"       />
        <result property="delFlag"     column="del_flag"     />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"  column="update_time"  />
        <result property="remark"      column="remark"       />
    </resultMap>

    <sql id="selectMealCategoryVo">
        select category_id, dept_id, name, icon, sort, status, del_flag,
               create_by, create_time, update_by, update_time, remark
        from meal_category
    </sql>

    <!--
      公共分类（dept_id = 0）与当前家庭的私有分类一起返回。
      这里刻意不用 @DataScope：数据权限只会拼出「dept_id = 本部门」，
      会把公共分类一并过滤掉。
    -->
    <select id="selectMealCategoryList" parameterType="MealCategory" resultMap="MealCategoryResult">
        <include refid="selectMealCategoryVo"/>
        <where>
            del_flag = '0'
            <if test="deptId != null">
                AND (dept_id = #{deptId} or dept_id = 0)
            </if>
            <if test="name != null and name != ''">
                AND name like concat('%', #{name}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        order by sort asc, category_id asc
    </select>

    <select id="selectMealCategoryById" parameterType="Long" resultMap="MealCategoryResult">
        <include refid="selectMealCategoryVo"/>
        where category_id = #{categoryId} and del_flag = '0'
    </select>

    <insert id="insertMealCategory" parameterType="MealCategory" useGeneratedKeys="true" keyProperty="categoryId">
        insert into meal_category (
            dept_id, name, icon, sort, status, del_flag,
            create_by, create_time, remark
        ) values (
            #{deptId}, #{name}, #{icon}, #{sort}, #{status}, '0',
            #{createBy}, sysdate(), #{remark}
        )
    </insert>

    <update id="updateMealCategory" parameterType="MealCategory">
        update meal_category
        <set>
            <if test="deptId != null">dept_id = #{deptId},</if>
            <if test="name != null and name != ''">name = #{name},</if>
            <if test="icon != null">icon = #{icon},</if>
            <if test="sort != null">sort = #{sort},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where category_id = #{categoryId} and del_flag = '0'
    </update>

    <update id="deleteMealCategoryByIds" parameterType="Long">
        update meal_category set del_flag = '2', update_time = sysdate()
        where del_flag = '0' and category_id in
        <foreach item="categoryId" collection="array" open="(" separator="," close=")">
            #{categoryId}
        </foreach>
    </update>

    <select id="countDishByCategoryId" parameterType="Long" resultType="int">
        select count(1) from meal_dish where del_flag = '0' and category_id = #{categoryId}
    </select>

</mapper>
