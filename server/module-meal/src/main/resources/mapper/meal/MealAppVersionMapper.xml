<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
"http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.howe.meal.mapper.MealAppVersionMapper">

    <resultMap type="MealAppVersion" id="MealAppVersionResult">
        <result property="versionId"   column="version_id"   />
        <result property="versionName" column="version_name" />
        <result property="versionCode" column="version_code" />
        <result property="wgtUrl"      column="wgt_url"      />
        <result property="wgtSize"     column="wgt_size"     />
        <result property="fileName"    column="file_name"    />
        <result property="updateLog"   column="update_log"   />
        <result property="forceUpdate" column="force_update" />
        <result property="status"      column="status"       />
        <result property="delFlag"     column="del_flag"     />
        <result property="createBy"    column="create_by"    />
        <result property="createTime"  column="create_time"  />
        <result property="updateBy"    column="update_by"    />
        <result property="updateTime"  column="update_time"  />
        <result property="remark"      column="remark"       />
    </resultMap>

    <sql id="selectMealAppVersionVo">
        select version_id, version_name, version_code, wgt_url, wgt_size, file_name, update_log,
               force_update, status, del_flag, create_by, create_time, update_by, update_time, remark
        from meal_app_version
    </sql>

    <select id="selectMealAppVersionList" parameterType="MealAppVersion" resultMap="MealAppVersionResult">
        <include refid="selectMealAppVersionVo"/>
        <where>
            del_flag = '0'
            <if test="versionName != null and versionName != ''">
                AND version_name like concat('%', #{versionName}, '%')
            </if>
            <if test="status != null and status != ''">
                AND status = #{status}
            </if>
        </where>
        order by version_code desc, version_id desc
    </select>

    <select id="selectMealAppVersionById" parameterType="Long" resultMap="MealAppVersionResult">
        <include refid="selectMealAppVersionVo"/>
        where version_id = #{versionId} and del_flag = '0'
    </select>

    <!-- 已发布的最新版本：version_code 最大，并列取创建时间最新 -->
    <select id="selectLatestPublished" resultMap="MealAppVersionResult">
        <include refid="selectMealAppVersionVo"/>
        where del_flag = '0' and status = '0'
        order by version_code desc, create_time desc, version_id desc
        limit 1
    </select>

    <insert id="insertMealAppVersion" parameterType="MealAppVersion" useGeneratedKeys="true" keyProperty="versionId">
        insert into meal_app_version (
            version_name, version_code, wgt_url, wgt_size, file_name, update_log,
            force_update, status, del_flag, create_by, create_time, remark
        ) values (
            #{versionName}, #{versionCode}, #{wgtUrl}, #{wgtSize}, #{fileName}, #{updateLog},
            #{forceUpdate}, #{status}, '0', #{createBy}, sysdate(), #{remark}
        )
    </insert>

    <update id="updateMealAppVersion" parameterType="MealAppVersion">
        update meal_app_version
        <set>
            <if test="versionName != null and versionName != ''">version_name = #{versionName},</if>
            <if test="versionCode != null">version_code = #{versionCode},</if>
            <if test="wgtUrl != null and wgtUrl != ''">wgt_url = #{wgtUrl},</if>
            <if test="wgtSize != null">wgt_size = #{wgtSize},</if>
            <if test="fileName != null">file_name = #{fileName},</if>
            <if test="updateLog != null">update_log = #{updateLog},</if>
            <if test="forceUpdate != null and forceUpdate != ''">force_update = #{forceUpdate},</if>
            <if test="status != null and status != ''">status = #{status},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            update_time = sysdate()
        </set>
        where version_id = #{versionId} and del_flag = '0'
    </update>

    <update id="deleteMealAppVersionByIds" parameterType="Long">
        update meal_app_version set del_flag = '2', update_time = sysdate()
        where del_flag = '0' and version_id in
        <foreach item="versionId" collection="array" open="(" separator="," close=")">
            #{versionId}
        </foreach>
    </update>

</mapper>
