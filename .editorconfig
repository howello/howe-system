# 行分隔符统一 CRLF，详见仓库根 CLAUDE.md「约定 > 行分隔符」
root = true

[*]
end_of_line = crlf
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{js,jsx,ts,tsx,vue,json,jsonc,yml,yaml,css,scss,html}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
